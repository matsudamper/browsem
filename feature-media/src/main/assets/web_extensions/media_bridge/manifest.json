{
  "manifest_version": 2,
  "name": "Media Bridge",
  "version": "1.0",
  "background": {
    "scripts": ["diagnostics.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "media-bridge@browsem"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "about:*"
      ],
      "js": [
        "playback_policy.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
