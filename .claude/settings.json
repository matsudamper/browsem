{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(unzip:*)",
      "Bash(git:log:*)",
      "Bash(git:diff:*)",
      "Bash(git:mv:*)",
      "Bash(git:show:*)",
      "Bash(xargs grep:*)",
      "Bash(find:*)",
      "Bash(javap:*)",
      "Read(./**)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger"
    ],
    "additionalDirectories": [
      "~/.gradle"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/setup.sh\"",
            "timeout": 900
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
