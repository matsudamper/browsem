{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(unzip:*)",
      "Bash(git:log:*)",
      "Bash(git:diff:*)",
      "Bash(git:mv:*)",
      "Bash(git:show:*)",
      "Bash(xargs grep:*)",
      "Bash(find:*)",
      "Bash(javap:*)",
      "Read(./**)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "mcp__Claude_Code_Remote__send_later"
    ],
    "additionalDirectories": [
      "~/.gradle"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "CronCreate|ScheduleWakeup|mcp__Claude_Code_Remote__create_trigger|mcp__Claude_Code_Remote__fire_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/deny-scheduled-checkin.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
