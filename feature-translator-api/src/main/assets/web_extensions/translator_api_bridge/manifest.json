{
  "manifest_version": 2,
  "name": "Translator API Bridge",
  "version": "1.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "translator-api-bridge@browsem"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "browsemTranslation": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "browsemTranslation"
          ]
        ],
        "script": "experiment/parent.js"
      }
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
