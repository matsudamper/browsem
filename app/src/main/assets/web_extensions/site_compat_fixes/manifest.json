{
  "manifest_version": 2,
  "name": "Site Compat Fixes",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "site-compat-fixes@browsem"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "x_image_viewer_pinch.js"
      ],
      "run_at": "document_start"
    }
  ]
}
