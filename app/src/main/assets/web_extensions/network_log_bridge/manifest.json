{
  "manifest_version": 2,
  "name": "Network Log Bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "network-log-bridge@browsem"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "about:*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "webRequest",
    "tabs",
    "<all_urls>"
  ]
}
