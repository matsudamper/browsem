{
  "manifest_version": 2,
  "name": "WebRequest Probe",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "web-request-probe@browsem"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": [
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "<all_urls>"
  ]
}
