<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            ATD イメージには LatinIME が含まれずソフトキーボードが存在しないため、
            テストから有効化するダミー IME を androidTest APK 側に持つ。
        -->
        <service
            android:name="net.matsudamper.browser.TestInputMethodService"
            android:exported="true"
            android:label="Browsem Test IME"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/test_input_method" />
        </service>
    </application>

</manifest>
