{
  "manifest_version": 2,
  "name": "Web Share Files Bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "web-share-files-bridge@browsem"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "page-share-reader.js"
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
